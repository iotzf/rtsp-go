# RTSP代理服务器Dockerfile
FROM golang:1.21-alpine AS builder

# 设置工作目录
WORKDIR /app

# 安装必要的包
RUN apk add --no-cache git

# 复制go mod文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建代理程序
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o rtsp-proxy ./proxy/

# 最终镜像
FROM alpine:latest

# 安装必要的运行时依赖
RUN apk --no-cache add ca-certificates tzdata

# 创建非root用户
RUN addgroup -g 1001 -S rtsp && \
    adduser -u 1001 -S rtsp -G rtsp

# 设置工作目录
WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /app/rtsp-proxy .

# 创建日志目录
RUN mkdir -p /app/logs && chown -R rtsp:rtsp /app

# 创建配置文件目录
RUN mkdir -p /app/config && chown -R rtsp:rtsp /app/config

# 复制默认配置文件
COPY --from=builder /app/proxy/config.json /app/config/

# 切换到非root用户
USER rtsp

# 暴露端口
EXPOSE 8555 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# 启动命令
CMD ["./rtsp-proxy", "-config", "/app/config/config.json"]
